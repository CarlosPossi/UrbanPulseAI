DATABASE_URL=postgresql://urbanpulse:urbanpulse@db:5432/urbanpulse
REDIS_URL=redis://redis:6379/0
ADMIN_KEY=troque-esta-chave
# true = não chama webhooks (registra ações como "simulated")
DRY_RUN=false
# token enviado aos webhooks reais (Authorization: Bearer ...)
WEBHOOK_TOKEN=
ALERT_THRESHOLD=0.6
CRITICAL_THRESHOLD=0.85
RESOLVE_THRESHOLD=0.3
RATE_LIMIT_PER_MIN=120

# ---- Telegram (notificações no celular) ----
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token.
# 2) Envie qualquer mensagem ao seu bot e abra https://api.telegram.org/bot<TOKEN>/getUpdates para ver o "chat":{"id":...}.
# 3) Vários destinatários? Separe os IDs por vírgula (inclusive grupos, que têm ID negativo).
TELEGRAM_BOT_TOKEN=9036050655:AAFZvGMPBpYN2DYmmE441MscAyT8AqeKxWs
TELEGRAM_CHAT_ID=1672476385
# Canal/grupo separado para moradores da região (pode usar o mesmo bot)
TELEGRAM_RESIDENT_BOT_TOKEN=9034981975:AAEX14xWOVmM1S4xQautNneVJ0ySOo6sou8
TELEGRAM_RESIDENT_CHAT_ID=1672476385
# URL pública https do painel (cria o botão "Abrir painel ao vivo" na mensagem). Deixe vazio em localhost.
PUBLIC_URL=

# ---- Demonstração ----
DEMO_CONTROLS=true          # mostra o botão "Simular ocorrência" no painel
DEMO_SPEEDUP=30             # 1 min real de deslocamento = 2 s na animação
EVENT_EVERY_SECONDS=240     # intervalo médio (s) entre eventos espontâneos dos nós
OSRM_URL=https://router.project-osrm.org   # rotas por ruas reais; sem internet usa rota sintética
